{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_destino": "/etc/claude-code/managed-settings.json SOMENTE na máquina/VM entregue ao consultor externo de segurança. Mesmo conteúdo de servico-agendamento/.claude/perfis/consultor-seguranca.json, mais as travas que só existem no escopo managed.",
  "allowManagedPermissionRulesOnly": true,
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status *)"
    ],
    "deny": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(.venv/*)",
      "Bash(./.venv/*)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(pip *)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(touch *)",
      "Bash(mkdir *)",
      "Bash(chmod *)",
      "Bash(tee *)",
      "Bash(sed -i *)",
      "Bash(bash *)",
      "Bash(sh *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git reset *)",
      "Bash(git apply *)",
      "Bash(terraform *)",
      "Bash(psql *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "WebFetch"
    ]
  },
  "allowManagedHooksOnly": true,
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false
  }
}
