{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YQX1PJMNkvzpRnH2yKMiCp","type":"tool_result","content":"1\t\"\"\"Regras de agendamento e cancelamento de consultas.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom dataclasses import dataclass\n6\tfrom datetime import datetime, timedelta\n7\t\n8\tANTECEDENCIA_MINIMA_CANCELAMENTO = timedelta(hours=24)\n9\t\n10\t\n11\t@dataclass\n12\tclass Consulta:\n13\t    id: int\n14\t    paciente_id: int\n15\t    medico_id: int\n16\t    inicio: datetime\n17\t    duracao_min: int = 30\n18\t    status: str = \"agendada\"\n19\t\n20\t    @property\n21\t    def fim(self) -> datetime:\n22\t        return self.inicio + timedelta(minutes=self.duracao_min)\n23\t\n24\t\n25\tdef conflita(a: Consulta, b: Consulta) -> bool:\n26\t    \"\"\"Duas consultas do mesmo médico conflitam quando os intervalos [inicio, fim) se sobrepõem.\"\"\"\n27\t    if a.medico_id != b.medico_id:\n28\t        return False\n29\t    return a.inicio < b.fim and b.inicio < a.fim\n30\t\n31\t\n32\tdef agendar(agenda: list[Consulta], nova: Consulta) -> Consulta:\n33\t    \"\"\"Inclui ``nova`` na agenda, recusando conflito de horário.\"\"\"\n34\t    for existente in agenda:\n35\t        if existente.status == \"agendada\" and conflita(existente, nova):\n36\t            raise ValueError(f\"Conflito com a consulta {existente.id} do médico {nova.medico_id}\")\n37\t    agenda.append(nova)\n38\t    return nova\n39\t\n40\t\n41\tdef cancelar(consulta: Consulta, agora: datetime) -> Consulta:\n42\t    \"\"\"Cancela respeitando a antecedência mínima de 24 h.\"\"\"\n43\t    if consulta.inicio - agora < ANTECEDENCIA_MINIMA_CANCELAMENTO:\n44\t        raise ValueError(\"Cancelamento exige 24 h de antecedência\")\n45\t    consulta.status = \"cancelada\"\n46\t    return consulta\n47\t"}]},"parent_tool_use_id":null,"session_id":"e2c3bcbe-d5ac-43ff-a55e-dfdab4f572a3","uuid":"193626d7-4325-4d09-9b09-b7d1d99565f3","timestamp":"2026-11-23T12:20:43.031Z","tool_use_result":{"type":"text","file":{"filePath":"/home/jowlt/TP2-AC/servico-agendamento/agendamento/consultas.py","content":"\"\"\"Regras de agendamento e cancelamento de consultas.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom datetime import datetime, timedelta\n\nANTECEDENCIA_MINIMA_CANCELAMENTO = timedelta(hours=24)\n\n\n@dataclass\nclass Consulta:\n    id: int\n    paciente_id: int\n    medico_id: int\n    inicio: datetime\n    duracao_min: int = 30\n    status: str = \"agendada\"\n\n    @property\n    def fim(self) -> datetime:\n        return self.inicio + timedelta(minutes=self.duracao_min)\n\n\ndef conflita(a: Consulta, b: Consulta) -> bool:\n    \"\"\"Duas consultas do mesmo médico conflitam quando os intervalos [inicio, fim) se sobrepõem.\"\"\"\n    if a.medico_id != b.medico_id:\n        return False\n    return a.inicio < b.fim and b.inicio < a.fim\n\n\ndef agendar(agenda: list[Consulta], nova: Consulta) -> Consulta:\n    \"\"\"Inclui ``nova`` na agenda, recusando conflito de horário.\"\"\"\n    for existente in agenda:\n        if existente.status == \"agendada\" and conflita(existente, nova):\n            raise ValueError(f\"Conflito com a consulta {existente.id} do médico {nova.medico_id}\")\n    agenda.append(nova)\n    return nova\n\n\ndef cancelar(consulta: Consulta, agora: datetime) -> Consulta:\n    \"\"\"Cancela respeitando a antecedência mínima de 24 h.\"\"\"\n    if consulta.inicio - agora < ANTECEDENCIA_MINIMA_CANCELAMENTO:\n        raise ValueError(\"Cancelamento exige 24 h de antecedência\")\n    consulta.status = \"cancelada\"\n    return consulta\n","numLines":47,"startLine":1,"totalLines":47}}}
