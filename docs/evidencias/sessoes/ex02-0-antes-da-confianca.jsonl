{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GtsW3juXZjuh6Z12wfPv1y","type":"tool_result","content":"The file /home/jowlt/TP2-AC/servico-agendamento/agendamento/consultas.py has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"0aa7733a-a852-4813-8244-b644a251a610","uuid":"c452a535-7feb-44ee-a87c-5e7ff19e8ec2","timestamp":"2026-11-23T12:16:15.204Z","tool_use_result":{"filePath":"/home/jowlt/TP2-AC/servico-agendamento/agendamento/consultas.py","oldString":"    \"\"\"Duas consultas do mesmo médico conflitam se os intervalos se sobrepõem.\"\"\"","newString":"    \"\"\"Duas consultas do mesmo médico conflitam quando os intervalos [inicio, fim) se sobrepõem.\"\"\"","originalFile":"\"\"\"Regras de agendamento e cancelamento de consultas.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom datetime import datetime, timedelta\n\nANTECEDENCIA_MINIMA_CANCELAMENTO = timedelta(hours=24)\n\n\n@dataclass\nclass Consulta:\n    id: int\n    paciente_id: int\n    medico_id: int\n    inicio: datetime\n    duracao_min: int = 30\n    status: str = \"agendada\"\n\n    @property\n    def fim(self) -> datetime:\n        return self.inicio + timedelta(minutes=self.duracao_min)\n\n\ndef conflita(a: Consulta, b: Consulta) -> bool:\n    \"\"\"Duas consultas do mesmo médico conflitam se os intervalos se sobrepõem.\"\"\"\n    if a.medico_id != b.medico_id:\n        return False\n    return a.inicio < b.fim and b.inicio < a.fim\n\n\ndef agendar(agenda: list[Consulta], nova: Consulta) -> Consulta:\n    \"\"\"Inclui ``nova`` na agenda, recusando conflito de horário.\"\"\"\n    for existente in agenda:\n        if existente.status == \"agendada\" and conflita(existente, nova):\n            raise ValueError(f\"Conflito com a consulta {existente.id} do médico {nova.medico_id}\")\n    agenda.append(nova)\n    return nova\n\n\ndef cancelar(consulta: Consulta, agora: datetime) -> Consulta:\n    \"\"\"Cancela respeitando a antecedência mínima de 24 h.\"\"\"\n    if consulta.inicio - agora < ANTECEDENCIA_MINIMA_CANCELAMENTO:\n        raise ValueError(\"Cancelamento exige 24 h de antecedência\")\n    consulta.status = \"cancelada\"\n    return consulta\n","structuredPatch":[{"oldStart":23,"oldLines":7,"newStart":23,"newLines":7,"lines":[" "," "," def conflita(a: Consulta, b: Consulta) -> bool:","-    \"\"\"Duas consultas do mesmo médico conflitam se os intervalos se sobrepõem.\"\"\"","+    \"\"\"Duas consultas do mesmo médico conflitam quando os intervalos [inicio, fim) se sobrepõem.\"\"\"","     if a.medico_id != b.medico_id:","         return False","     return a.inicio < b.fim and b.inicio < a.fim"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true}}
