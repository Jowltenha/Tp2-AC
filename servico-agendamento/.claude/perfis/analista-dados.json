{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(ls *)"
    ],
    "deny": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(.venv/*)",
      "Bash(psql *)",
      "Read(agendamento/**)",
      "Read(tests/**)",
      "Read(.claude/hooks/**)"
    ]
  }
}
